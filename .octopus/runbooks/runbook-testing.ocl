name = "Runbook Testing"
cancel_queued_tasks = true
cancel_running_tasks = true
default_guided_failure_mode = "EnvironmentDefault"
description = ""

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    type = "Default"
}

process {
    step "package-step-template" {
        name = "Package Step Template"
        properties = {
            Octopus.Action.TargetRoles = "kube"
        }

        action {
            properties = {
                Octopus.Action.Package.FeedId = "octopus-server-built-in"
                Octopus.Action.Package.PackageId = "blurp"
                Octopus.Action.RunOnServer = "false"
                Octopus.Action.Template.Id = "ActionTemplates-5883"
                Octopus.Action.Template.Version = "0"
                PackageVar = "{\"PackageId\":\"blurp\",\"FeedId\":\"octopus-server-built-in\"}"
            }
            worker_pool_variable = ""

            packages {
                acquisition_location = "Server"
                feed = "octopus-server-built-in"
                package_id = "blurp"
                properties = {
                    PackageParameterName = "PackageVar"
                    SelectionMode = "deferred"
                }
                version = "1.0.0"
            }
        }
    }

    step "deploy-a-package" {
        name = "Deploy a Package"
        properties = {
            Octopus.Action.TargetRoles = "cli"
        }

        action {
            action_type = "Octopus.TentaclePackage"
            properties = {
                Octopus.Action.EnabledFeatures = ",Octopus.Features.ConfigurationTransforms,Octopus.Features.ConfigurationVariables"
                Octopus.Action.Package.AutomaticallyRunConfigurationTransformationFiles = "True"
                Octopus.Action.Package.AutomaticallyUpdateAppSettingsAndConnectionStrings = "True"
                Octopus.Action.Package.DownloadOnTentacle = "False"
                Octopus.Action.Package.FeedId = "octopus-server-built-in"
                Octopus.Action.Package.PackageId = "appsettings"
                Octopus.Action.RunOnServer = "false"
            }
            worker_pool_variable = ""

            packages {
                acquisition_location = "Server"
                feed = "octopus-server-built-in"
                package_id = "appsettings"
                properties = {
                    SelectionMode = "immediate"
                }
                version = "2.0.0"
            }
        }
    }

    step "run-a-script" {
        name = "Run a Script"
        properties = {
            Octopus.Action.TargetRoles = "jsm"
        }

        action {
            action_type = "Octopus.Script"
            properties = {
                Octopus.Action.RunOnServer = "false"
                Octopus.Action.Script.ScriptBody = "write-host 'hi'"
                Octopus.Action.Script.ScriptSource = "Inline"
                Octopus.Action.Script.Syntax = "PowerShell"
            }
            worker_pool_variable = ""

            packages "package" {
                acquisition_location = "Server"
                feed = "octopus-server-built-in"
                package_id = "package"
                properties = {
                    Extract = "True"
                    SelectionMode = "immediate"
                }
                version = "26.10.20708.0-pr-19725"
            }
        }
    }
}
